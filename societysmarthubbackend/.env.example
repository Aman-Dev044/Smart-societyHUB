# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/society-management

# JWT Secrets (Generate secure random strings for production)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-access-token-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000




# ----------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# ----------------------------------------------------------------------
# Teen options hain, koi ek chuniye (priority isi order me hai):
#
# 1) LIVE SERVER (recommended) - pura service account JSON ek env var me.
#    Multi-line private key env var me tootti hai, isliye base64 best hai:
#      Linux/Mac : base64 -w0 serviceAccountKey.json
#      Windows   : certutil -encode serviceAccountKey.json tmp.b64
#    Raw JSON bhi chalega (single line, "{" se shuru).
# FIREBASE_SERVICE_ACCOUNT=
#
# 2) Custom file path (backend root se relative, ya absolute).
# FIREBASE_SERVICE_ACCOUNT_PATH=secrets/serviceAccountKey.json
#
# 3) LOCAL DEV (default) - kuch set na karein, bas file yahan rakh dein:
#    societysmarthubbackend/serviceAccountKey.json
#
# Kuch bhi set na ho to backend normal chalega, bas push skip karega.

# ----------------------------------------------------------------------
# Overstay alerts (guard ko security notification)
# ----------------------------------------------------------------------
# Daily staff (maid, cook) kitne ghante baad overstay mana jaye.
# STAFF_OVERSTAY_HOURS=4
#
# One-time technician / delivery ke liye alag threshold. Set na karein to
# STAFF_OVERSTAY_HOURS hi use hota hai. Technician ka kaam lamba ho sakta hai
# (AC repair, furniture assembly), isliye ise zyada rakh sakte hain.
# ONE_TIME_OVERSTAY_HOURS=4
#
# Itne ghante se purane open records par alert nahi jata (abandoned records —
# guard exit mark karna bhool gaya). "3000 hrs inside" ka alert noise hai.
# STAFF_OVERSTAY_MAX_AGE_HOURS=48
#
# Cron kitni der me ek baar check kare.
# STAFF_OVERSTAY_CRON=*/15 * * * *
