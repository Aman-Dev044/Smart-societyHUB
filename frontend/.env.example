VITE_API_BASE_URL=http://localhost:4000/api

# ----------------------------------------------------------------------
# Firebase (FCM push notifications)
# ----------------------------------------------------------------------
# Ye saari values PUBLIC hain - backend ki serviceAccountKey.json se alag.
#
# Kahan se milengi:
#   Firebase Console -> Project Settings -> General -> Your apps -> Web app
#   (agar web app nahi bani hai to "Add app" -> Web se bana lein)
#
# VAPID key:
#   Firebase Console -> Project Settings -> Cloud Messaging
#   -> Web Push certificates -> "Generate key pair" -> key copy karein
#
# Ye khaali chhodne par push chup-chaap disable rehta hai, app normal chalegi.

VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
